{
  "server": {
    "apiProcessingTimeout": "PT15S"
  },
  "routingDefaults": {
    "numItineraries": 10,
    "searchWindow": "PT120M",
    "transferSlack": "PT1M",
    "transferPenalty": 60,
    "nonpreferredTransferPenalty": 120,
    "maxJourneyDuration": "PT3H",
    "maxDirectStreetDuration": "PT15M",
    "streetRoutingTimeout": "PT1S",
    "accessEgress": {
      "maxDuration": "PT120M",
      "maxStopCount": 40
    },
    "transitReluctanceForMode": {
      "SUBWAY": 1.0,
      "BUS": 1.0
    },
    "transferOptimization": {
      "optimizeTransferWaitTime": true,
      "minSafeWaitTimeFactor": 4.0,
      "backTravelWaitTimeFactor": 1.5,
      "extraStopBoardAlightCostsFactor": 2.0
    },
    "itineraryFilters": {
      "groupSimilarityKeepOne": 0.85,
      "groupSimilarityKeepThree": 0.65,
      "groupedOtherThanSameLegsMaxCostMultiplier": 2.0,
      "transitGeneralizedCostLimit": {
        "costLimitFunction": "900 + 2.0x",
        "intervalRelaxFactor": 0.5
      }
    }
  },
  "transit": {
    "searchThreadPoolSize": 8,
    "maxNumberOfTransfers": 4,
    "iterationDepartureStepInSeconds": 180,
    "scheduledTripBinarySearchThreshold": 20,
    "earlyTransferPruning": false,
    "transferCacheMaxSize": 8000,
    "maxSearchWindow": "PT4H",
    "dynamicSearchWindow": {
      "minWindow": "PT30M",
      "maxWindow": "PT120M",
      "stepMinutes": 15
    }
  },
  "timetableUpdates": {
    "purgeExpiredData": true
  }
}
