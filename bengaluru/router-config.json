{
  "server": {
    "apiProcessingTimeout": "PT10S"
  },
  "routingDefaults": {
    "numItineraries": 5,
    "searchWindow": "PT45M",
    "transferSlack": "PT1M",
    "transferPenalty": 120,
    "nonpreferredTransferPenalty": 240,
    "maxJourneyDuration": "PT3H",
    "maxDirectStreetDuration": "PT15M",
    "streetRoutingTimeout": "PT1S",
    "accessEgress": {
      "maxDuration": "PT120M",
      "maxStopCount": 30
    },
    "transitReluctanceForMode": {
      "SUBWAY": 0.6,
      "BUS": 1.35
    },
    "transferOptimization": {
      "optimizeTransferWaitTime": true,
      "minSafeWaitTimeFactor": 4.0,
      "backTravelWaitTimeFactor": 1.5,
      "extraStopBoardAlightCostsFactor": 2.0
    },
    "itineraryFilters": {
      "groupSimilarityKeepOne": 0.70,
      "groupSimilarityKeepThree": 0.50,
      "groupedOtherThanSameLegsMaxCostMultiplier": 1.35,
      "transitGeneralizedCostLimit": {
        "costLimitFunction": "420 + 1.25x",
        "intervalRelaxFactor": 0.4
      }
    },
    "relaxTransitGroupPriority": "1800s + 1.5 t",
    "transitGroupPriority": {
      "global": [
        { "modes": ["SUBWAY"] },
        { "modes": ["BUS"] }
      ]
    }
  },
  "transit": {
    "searchThreadPoolSize": 8,
    "maxNumberOfTransfers": 2,
    "iterationDepartureStepInSeconds": 180,
    "scheduledTripBinarySearchThreshold": 20,
    "earlyTransferPruning": true,
    "transferCacheMaxSize": 8000,
    "maxSearchWindow": "PT2H",
    "dynamicSearchWindow": {
      "minWindow": "PT15M",
      "maxWindow": "PT30M",
      "stepMinutes": 10
    }
  },
  "timetableUpdates": {
    "purgeExpiredData": true
  }
}
